# Rust build output
/target/
**/target/

# Compiled binary artifacts
*.exe
*.dll
*.lib
*.a
*.o
*.obj
*.pdb
*.so
*.dylib
*.dSYM/

# Build byproducts
*.log
*.tmp
*.temp
*.cache
*.orig
*.bak
*.old

# Environment / editor noise
**/.vscode/
**/.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Rust toolchain state
**/.cargo-home/
**/.rustup/
.cargo/

# Local environment and workspace snapshots
/.direnv/
.env
.env.*

# Windows cross toolchain outputs
*.d
*.rlib
*.rmeta

# Ignore local release copies
/mic_volume_fix_latest.exe

# Vendored crate noise; keep Cargo.toml, source, README, and licenses.
third_party/*/.cargo-ok
third_party/*/.cargo_vcs_info.json
third_party/*/.changes/
third_party/*/.github/
third_party/*/.git/
third_party/*/Cargo.lock
third_party/*/Cargo.toml.orig
third_party/*/appveyor.yml
third_party/*/.travis.yml
third_party/*/renovate.json
third_party/*/rustfmt.toml
third_party/*/*.sublime-project
third_party/*/examples/
third_party/*/resources/test/

# Nested tool build artifacts
third_party/*/target/
tools/*/target/
